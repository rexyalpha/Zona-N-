// 11. FUNCIONES
//=============================================================================
f_limpiarCajas(array<box> ids) =>
    while array.size(ids) > 0
        box.delete(array.pop(ids))

f_limpiarLineas(array<line> ids) =>
    while array.size(ids) > 0
        line.delete(array.pop(ids))

f_limpiarEtiquetas(array<label> ids) =>
    while array.size(ids) > 0
        label.delete(array.pop(ids))

f_nuevaCaja(array<box> ids, int izquierda, float techo, int derecha, float piso) =>
    box id = box.new(left=izquierda, top=techo, right=derecha, bottom=piso, xloc=xloc.bar_index, border_color=colorBordeBalance, border_width=grosorBordeBalance, bgcolor=color.new(colorCajaBalance, transparenciaCaja))
    array.push(ids, id)
    id

f_nuevaLinea(array<line> ids, int izquierda, float precio, int derecha, color tono, int ancho) =>
    line id = line.new(x1=izquierda, y1=precio, x2=derecha, y2=precio, xloc=xloc.bar_index, extend=extend.none, color=tono, width=ancho, style=line.style_solid)
    array.push(ids, id)
    id

f_nuevaEtiqueta(array<label> ids, int x, float precio, string nombre) =>
    label id = label.new(x=x, y=precio, text=nombre, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, color=color.new(color.white, 100), textcolor=colorNombres, size=tamanoNombreTV)
    array.push(ids, id)
    id

f_dibujarSesion(string nombreSesion, array<box> cajasDibujo, array<line> lineasDibujo, array<label> etiquetasDibujo, int xInicio, int xFinSesion, float techoRango, float pisoRango, bool dibujarCaja, bool dibujarNivel1, bool dibujarNivel2, bool dibujarExtensiones) =>
    f_limpiarCajas(cajasDibujo)
    f_limpiarLineas(lineasDibujo)
    f_limpiarEtiquetas(etiquetasDibujo)

    float rango = techoRango - pisoRango
    int xDerecha = xFinSesion + extensionDerecha

    if rango > syminfo.mintick
        float precioNivel1 = techoRango - rango * valorNivel1
        float precioNivel2 = techoRango - rango * valorNivel2
        float techoCaja = math.max(precioNivel1, precioNivel2)
        float pisoCaja = math.min(precioNivel1, precioNivel2)

        float extension1Arriba = techoRango - rango * valorExtension1
        float extension1Abajo = pisoRango + rango * valorExtension1
        float extension2Arriba = techoRango - rango * valorExtension2
        float extension2Abajo = pisoRango + rango * valorExtension2

        if mostrarNombres
            int centroZona = int(math.round((xInicio + xDerecha) * 0.5))
            float precioNombre = techoRango + rango * separacionNombre
            f_nuevaEtiqueta(etiquetasDibujo, centroZona, precioNombre, nombreSesion)

        if dibujarCaja
            f_nuevaCaja(cajasDibujo, xInicio, techoCaja, xDerecha, pisoCaja)

        if dibujarNivel1
            f_nuevaLinea(lineasDibujo, xInicio, precioNivel1, xDerecha, colorNivel1, grosorNivel1)

        if dibujarNivel2
            f_nuevaLinea(lineasDibujo, xInicio, precioNivel2, xDerecha, colorNivel2, grosorNivel2)

        if dibujarExtensiones
            if mostrarExt1Arriba
                f_nuevaLinea(lineasDibujo, xInicio, extension1Arriba, xDerecha, colorExtension1, grosorExtension1)

            if mostrarExt1Abajo
                f_nuevaLinea(lineasDibujo, xInicio, extension1Abajo, xDerecha, colorExtension1, grosorExtension1)

            if mostrarExt2Arriba
                f_nuevaLinea(lineasDibujo, xInicio, extension2Arriba, xDerecha, colorExtension2, grosorExtension2)

            if mostrarExt2Abajo
                f_nuevaLinea(lineasDibujo, xInicio, extension2Abajo, xDerecha, colorExtension2, grosorExtension2)

    0

