//=============================================================================
string tickerMayus = str.upper(syminfo.ticker)
string raizMayus = str.upper(syminfo.root)

bool esOro = str.contains(tickerMayus, "XAU") or str.contains(tickerMayus, "GOLD") or raizMayus == "GC" or raizMayus == "MGC"
bool esNasdaq = str.contains(tickerMayus, "NAS") or str.contains(tickerMayus, "NDX") or str.contains(tickerMayus, "QQQ") or raizMayus == "NQ" or raizMayus == "MNQ"

string mercadoDetectado = modoMercado == "Oro" ? "Oro" : modoMercado == "Nasdaq" ? "Nasdaq" : modoMercado == "Manual" ? "Manual" : esOro ? "Oro" : esNasdaq ? "Nasdaq" : "Manual"
string simboloSecundario = mercadoDetectado == "Oro" ? secundarioOro : mercadoDetectado == "Nasdaq" ? secundarioNasdaq : secundarioManual

f_rangoSecundarioDash(string horario, string zona) =>
    bool dentro = not na(time(timeframe.period, horario, zona))
    bool inicia = dentro and (bar_index == 0 or not dentro[1])

    var float maximo = na
    var float minimo = na

    if inicia
        maximo := high
        minimo := low
    else if dentro
        maximo := math.max(nz(maximo, high), high)
        minimo := math.min(nz(minimo, low), low)

    [maximo, minimo]

f_datosSecundarioDash() =>
    [altoA, bajoA] = f_rangoSecundarioDash(sesionAsia, tzAsia)
    [altoL, bajoL] = f_rangoSecundarioDash(sesionLondon, tzLondon)
    [altoN, bajoN] = f_rangoSecundarioDash(sesionNY, tzNY)

    [altoA, bajoA, altoL, bajoL, altoN, bajoN, open, high, low, close, time]

[secAltoAsia, secBajoAsia, secAltoLondon, secBajoLondon, secAltoNY, secBajoNY, openSecundario, highSecundario, lowSecundario, precioSecundario, tiempoSecundario] = request.security(simboloSecundario, timeframe.period, f_datosSecundarioDash(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

//-----------------------------------------------------------------------------
// 15.b  SESION CERRADA · VIGENCIA · RANGO MINIMO
//-----------------------------------------------------------------------------
float atr20 = ta.atr(20)

var int   seccionCerrada = 0
var int   tiempoCierre   = na
var float altoCerrado    = na
var float bajoCerrado    = na
var float secAltoCerrado = na
var float secBajoCerrado = na

if terminaAsia and not na(maximoAsia) and not na(minimoAsia)
    seccionCerrada := 1
    tiempoCierre   := time
    altoCerrado    := maximoAsia
    bajoCerrado    := minimoAsia
    secAltoCerrado := secAltoAsia
    secBajoCerrado := secBajoAsia

if terminaLondon and not na(maximoLondon) and not na(minimoLondon)
    seccionCerrada := 2
    tiempoCierre   := time
    altoCerrado    := maximoLondon
    bajoCerrado    := minimoLondon
    secAltoCerrado := secAltoLondon
    secBajoCerrado := secBajoLondon

if terminaNY and not na(maximoNY) and not na(minimoNY)
    seccionCerrada := 3
    tiempoCierre   := time
    altoCerrado    := maximoNY
    bajoCerrado    := minimoNY
    secAltoCerrado := secAltoNY
    secBajoCerrado := secBajoNY

var int ultimaSeccionDash = 0

if iniciaAsia
    ultimaSeccionDash := 1
else if iniciaLondon
    ultimaSeccionDash := 2
else if iniciaNY
    ultimaSeccionDash := 3

int seccionViva = dentroAsia ? 1 : dentroLondon ? 2 : dentroNY ? 3 : ultimaSeccionDash
int seccionDash = soloSesionCerrada ? seccionCerrada : seccionViva

string nombreSeccionDash = seccionDash == 1 ? "ASIA" : seccionDash == 2 ? "LONDON" : seccionDash == 3 ? "NEW YORK" : "ESPERANDO CIERRE"

float altoPrincipalDash = soloSesionCerrada ? altoCerrado : seccionDash == 1 ? maximoAsia : seccionDash == 2 ? maximoLondon : seccionDash == 3 ? maximoNY : na
float bajoPrincipalDash = soloSesionCerrada ? bajoCerrado : seccionDash == 1 ? minimoAsia : seccionDash == 2 ? minimoLondon : seccionDash == 3 ? minimoNY : na

float altoSecundarioDash = soloSesionCerrada ? secAltoCerrado : seccionDash == 1 ? secAltoAsia : seccionDash == 2 ? secAltoLondon : seccionDash == 3 ? secAltoNY : na
float bajoSecundarioDash = soloSesionCerrada ? secBajoCerrado : seccionDash == 1 ? secBajoAsia : seccionDash == 2 ? secBajoLondon : seccionDash == 3 ? secBajoNY : na

float rangoPrincipalDash = altoPrincipalDash - bajoPrincipalDash
float rangoSecundarioDash = altoSecundarioDash - bajoSecundarioDash

float nivel1PrincipalDash = altoPrincipalDash - rangoPrincipalDash * valorNivel1
float nivel2PrincipalDash = altoPrincipalDash - rangoPrincipalDash * valorNivel2

float superiorZonaPrincipalDash = math.max(nivel1PrincipalDash, nivel2PrincipalDash)
float inferiorZonaPrincipalDash = math.min(nivel1PrincipalDash, nivel2PrincipalDash)
float centroZonaPrincipalDash = (superiorZonaPrincipalDash + inferiorZonaPrincipalDash) * 0.5

float nivel1SecundarioDash = altoSecundarioDash - rangoSecundarioDash * valorNivel1
float nivel2SecundarioDash = altoSecundarioDash - rangoSecundarioDash * valorNivel2

float superiorZonaSecundarioDash = math.max(nivel1SecundarioDash, nivel2SecundarioDash)
float inferiorZonaSecundarioDash = math.min(nivel1SecundarioDash, nivel2SecundarioDash)
float centroZonaSecundarioDash = (superiorZonaSecundarioDash + inferiorZonaSecundarioDash) * 0.5

float segundosGrafico = timeframe.in_seconds(timeframe.period)

bool temporalidadValida = timeframe.isminutes and timeframe.multiplier == 5

bool rangoSuficiente = rangoMinimoATR <= 0.0 or (not na(atr20) and rangoPrincipalDash >= atr20 * rangoMinimoATR)

float horasDesdeCierre = na(tiempoCierre) ? na : (time - tiempoCierre) / 3600000.0
bool zonaVigente = horasVigencia == 0 or na(horasDesdeCierre) or horasDesdeCierre <= horasVigencia

bool datosPrincipalValidos = seccionDash > 0 and not na(altoPrincipalDash) and not na(bajoPrincipalDash) and rangoPrincipalDash > syminfo.mintick and rangoSuficiente and zonaVigente

bool datosSecundariosVigentes = not na(precioSecundario) and not na(tiempoSecundario) and not na(altoSecundarioDash) and not na(bajoSecundarioDash) and rangoSecundarioDash > 0.0 and math.abs(time - tiempoSecundario) <= segundosGrafico * 2000.0

bool datosDashValidos = datosPrincipalValidos and datosSecundariosVigentes

f_estadoRangoDash(float precio, float altoRango, float bajoRango) =>
    na(precio) or na(altoRango) or na(bajoRango) ? 0 : precio > altoRango ? 1 : precio < bajoRango ? -1 : 0

f_estadoZonaDash(float precio, float superior, float inferior) =>
    na(precio) or na(superior) or na(inferior) ? 0 : precio > superior ? 1 : precio < inferior ? -1 : 0

f_textoRangoDash(int estado) =>
    estado == 1 ? "Arriba del alto" : estado == -1 ? "Debajo del bajo" : "Dentro del rango"

f_textoZonaDash(int estado) =>
    estado == 1 ? "Arriba de zona" : estado == -1 ? "Debajo de zona" : "Dentro de zona"

f_colorDireccionDash(int estado) =>
    estado == 1 ? colorTextoAlcista : estado == -1 ? colorTextoBajista : colorTextoNeutral

int estadoRangoPrincipal = f_estadoRangoDash(close, altoPrincipalDash, bajoPrincipalDash)
int estadoZonaPrincipal = f_estadoZonaDash(close, superiorZonaPrincipalDash, inferiorZonaPrincipalDash)

int estadoRangoSecundario = datosSecundariosVigentes ? f_estadoRangoDash(precioSecundario, altoSecundarioDash, bajoSecundarioDash) : 0
int estadoZonaSecundario = datosSecundariosVigentes ? f_estadoZonaDash(precioSecundario, superiorZonaSecundarioDash, inferiorZonaSecundarioDash) : 0

int direccionPrincipal = estadoRangoPrincipal != 0 ? estadoRangoPrincipal : estadoZonaPrincipal
int direccionSecundario = estadoRangoSecundario != 0 ? estadoRangoSecundario : estadoZonaSecundario

bool rangoAlineadoArriba = datosDashValidos and estadoRangoPrincipal == 1 and estadoRangoSecundario == 1
bool rangoAlineadoAbajo = datosDashValidos and estadoRangoPrincipal == -1 and estadoRangoSecundario == -1

bool zonaAlineadaArriba = datosDashValidos and estadoZonaPrincipal == 1 and estadoZonaSecundario == 1
bool zonaAlineadaAbajo = datosDashValidos and estadoZonaPrincipal == -1 and estadoZonaSecundario == -1

bool divergenciaDentroZona = datosDashValidos and (estadoZonaPrincipal == 0 or estadoZonaSecundario == 0)

bool direccionesOpuestas = datosDashValidos and direccionPrincipal != 0 and direccionSecundario != 0 and direccionPrincipal == -direccionSecundario

bool parcialAlcista = datosDashValidos and ((direccionPrincipal == 1 and direccionSecundario == 0) or (direccionSecundario == 1 and direccionPrincipal == 0))
bool parcialBajista = datosDashValidos and ((direccionPrincipal == -1 and direccionSecundario == 0) or (direccionSecundario == -1 and direccionPrincipal == 0))

bool divergenciaAltos = datosDashValidos and ((estadoRangoPrincipal == 1) != (estadoRangoSecundario == 1))
bool divergenciaBajos = datosDashValidos and ((estadoRangoPrincipal == -1) != (estadoRangoSecundario == -1))

float rangoTresVelas = math.max(nz(high - low) + nz(high[1] - low[1]) + nz(high[2] - low[2]), syminfo.mintick)

float cuerposTresVelas = math.abs(nz(close - open)) + math.abs(nz(close[1] - open[1])) + math.abs(nz(close[2] - open[2]))

float calidadMovimiento = cuerposTresVelas / rangoTresVelas

float presionPrincipal = nz(close - open) + nz(close[1] - open[1]) + nz(close[2] - open[2])

float rangoMedioPrincipal = math.max(nz(ta.sma(high - low, 20), high - low), syminfo.mintick)

float rangoMedioSecundario = math.max(nz(ta.sma(highSecundario - lowSecundario, 20), highSecundario - lowSecundario), 0.00000001)

float margenPrincipal = math.max((superiorZonaPrincipalDash - inferiorZonaPrincipalDash) * margenCentroPct, rangoMedioPrincipal * 0.10)

float margenSecundario = math.max((superiorZonaSecundarioDash - inferiorZonaSecundarioDash) * margenCentroPct, rangoMedioSecundario * 0.10)

bool presionPrincipalAlcista = datosPrincipalValidos and close > centroZonaPrincipalDash + margenPrincipal and close > close[1] and close - close[2] >= rangoMedioPrincipal * desplazamientoMinimo and presionPrincipal > 0.0 and calidadMovimiento >= calidadMinimaPct

bool presionPrincipalBajista = datosPrincipalValidos and close < centroZonaPrincipalDash - margenPrincipal and close < close[1] and close - close[2] <= -rangoMedioPrincipal * desplazamientoMinimo and presionPrincipal < 0.0 and calidadMovimiento >= calidadMinimaPct

bool presionSecundarioAlcista = datosSecundariosVigentes and precioSecundario > centroZonaSecundarioDash + margenSecundario and precioSecundario > precioSecundario[1] and precioSecundario - precioSecundario[2] >= rangoMedioSecundario * desplazamientoMinimo

bool presionSecundarioBajista = datosSecundariosVigentes and precioSecundario < centroZonaSecundarioDash - margenSecundario and precioSecundario < precioSecundario[1] and precioSecundario - precioSecundario[2] <= -rangoMedioSecundario * desplazamientoMinimo

bool candidatoAnticipadoAlcista = usarAlineacionAnticipada and presionPrincipalAlcista and presionSecundarioAlcista and not direccionesOpuestas

bool candidatoAnticipadoBajista = usarAlineacionAnticipada and presionPrincipalBajista and presionSecundarioBajista and not direccionesOpuestas

var int biasAnticipado = 0

if iniciaAsia or iniciaLondon or iniciaNY
    biasAnticipado := 0
else if candidatoAnticipadoAlcista
    biasAnticipado := 1
else if candidatoAnticipadoBajista
    biasAnticipado := -1
else if direccionesOpuestas
    biasAnticipado := 0

bool anticipadoAlcista = usarAlineacionAnticipada and biasAnticipado == 1 and datosDashValidos and estadoZonaPrincipal != -1 and estadoZonaSecundario != -1

bool anticipadoBajista = usarAlineacionAnticipada and biasAnticipado == -1 and datosDashValidos and estadoZonaPrincipal != 1 and estadoZonaSecundario != 1

string textoBias = "NEUTRAL"
color colorBias = colorTextoNeutral

if not temporalidadValida
    textoBias := "USA 5 MIN"
    colorBias := colorTextoBajista
else if seccionDash == 0
    textoBias := "ESPERANDO CIERRE"
    colorBias := color.gray
else if not zonaVigente
    textoBias := "ZONA VENCIDA"
    colorBias := color.gray
else if not rangoSuficiente
    textoBias := "RANGO ESTRECHO"
    colorBias := color.gray
else if not datosDashValidos
    textoBias := "SIN DATOS"
    colorBias := color.gray
else if divergenciaDentroZona
    textoBias := "DIVERGENCIA"
    colorBias := colorFondoDivergencia
else if rangoAlineadoArriba or zonaAlineadaArriba
    textoBias := "BUY"
    colorBias := colorTextoAlcista
else if rangoAlineadoAbajo or zonaAlineadaAbajo
    textoBias := "SELL"
    colorBias := colorTextoBajista
else if anticipadoAlcista or parcialAlcista
    textoBias := "BUY PARCIAL"
    colorBias := colorTextoAlcista
else if anticipadoBajista or parcialBajista
    textoBias := "SELL PARCIAL"
    colorBias := colorTextoBajista
else if direccionesOpuestas
    textoBias := "DIVERGENCIA"
    colorBias := colorFondoDivergencia

string textoEstructura = "DENTRO DE ZONA"
color fondoEstructura = colorFondoNeutral
color colorTextoEstructura = color.black

if not datosDashValidos
    textoEstructura := "SIN DATOS"
    fondoEstructura := color.gray
else if divergenciaDentroZona
    textoEstructura := "DIVERGENCIA"
    fondoEstructura := colorFondoDivergencia
else if direccionesOpuestas
    textoEstructura := "DESALINEADOS"
    fondoEstructura := colorFondoDesalineado
    colorTextoEstructura := color.white
else if zonaAlineadaArriba or zonaAlineadaAbajo or anticipadoAlcista or anticipadoBajista
    textoEstructura := "ESTRUCTURA ALINEADA"
    fondoEstructura := colorFondoAlineado
else if parcialAlcista or parcialBajista
    textoEstructura := "ALINEACION PARCIAL"
    fondoEstructura := colorFondoDivergencia

string textoEstadoRango = "NEUTRAL / ESPERANDO"
color fondoEstadoRango = colorFondoNeutral
color colorTextoEstadoRango = color.black

if not datosDashValidos
    textoEstadoRango := "SIN DATOS / CERRADO"
    fondoEstadoRango := color.gray
else if divergenciaDentroZona
    textoEstadoRango := "DIVERGENCIA"
    fondoEstadoRango := colorFondoDivergencia
else if direccionesOpuestas
    textoEstadoRango := "DESALINEADOS"
    fondoEstadoRango := colorFondoDesalineado
    colorTextoEstadoRango := color.white
else if rangoAlineadoArriba
    textoEstadoRango := "ALINEADOS ARRIBA"
    fondoEstadoRango := colorFondoAlineado
else if rangoAlineadoAbajo
    textoEstadoRango := "ALINEADOS ABAJO"
    fondoEstadoRango := colorFondoAlineado
else if divergenciaAltos
    textoEstadoRango := "DIVERGENCIA DE ALTOS"
    fondoEstadoRango := colorFondoDivergencia
else if divergenciaBajos
    textoEstadoRango := "DIVERGENCIA DE BAJOS"
    fondoEstadoRango := colorFondoDivergencia
else if zonaAlineadaArriba or zonaAlineadaAbajo or anticipadoAlcista or anticipadoBajista
    textoEstadoRango := "MISMA DIRECCION"
    fondoEstadoRango := colorFondoAlineado
else if parcialAlcista or parcialBajista
    textoEstadoRango := "ALINEACION PARCIAL"
    fondoEstadoRango := colorFondoDivergencia

string posicionDash = ubicacionDash == "Arriba izquierda" ? position.top_left : ubicacionDash == "Abajo derecha" ? position.bottom_right : ubicacionDash == "Abajo izquierda" ? position.bottom_left : position.top_right

var table tablero = table.new(posicionDash, 4, 4, bgcolor=colorFondoNeutral, border_color=color.black, border_width=1)

var bool tableroFusionado = false

if not tableroFusionado
    table.merge_cells(tablero, 0, 0, 2, 0)
    table.merge_cells(tablero, 3, 1, 3, 2)
    table.merge_cells(tablero, 1, 3, 3, 3)
    tableroFusionado := true

if barstate.islast
    if mostrarDash
        table.cell(tablero, 0, 0, "CONFLUENCIA · " + nombreSeccionDash, text_color=color.black, text_size=size.normal, bgcolor=colorFondoNeutral, text_halign=text.align_left)

        table.cell(tablero, 3, 0, textoBias, text_color=colorBias, text_size=size.normal, bgcolor=color.white, text_halign=text.align_center)

        table.cell(tablero, 0, 1, "Principal", text_color=color.black, text_size=size.small, bgcolor=colorFondoNeutral, text_halign=text.align_left)

        table.cell(tablero, 1, 1, f_textoRangoDash(estadoRangoPrincipal), text_color=f_colorDireccionDash(estadoRangoPrincipal), text_size=size.small, bgcolor=colorFondoNeutral)

        table.cell(tablero, 2, 1, f_textoZonaDash(estadoZonaPrincipal), text_color=f_colorDireccionDash(estadoZonaPrincipal), text_size=size.small, bgcolor=colorFondoNeutral)

        table.cell(tablero, 0, 2, simboloSecundario, text_color=color.black, text_size=size.small, bgcolor=colorFondoNeutral, text_halign=text.align_left)

        table.cell(tablero, 1, 2, datosSecundariosVigentes ? f_textoRangoDash(estadoRangoSecundario) : "Sin datos", text_color=datosSecundariosVigentes ? f_colorDireccionDash(estadoRangoSecundario) : color.gray, text_size=size.small, bgcolor=colorFondoNeutral)

        table.cell(tablero, 2, 2, datosSecundariosVigentes ? f_textoZonaDash(estadoZonaSecundario) : "Sin datos", text_color=datosSecundariosVigentes ? f_colorDireccionDash(estadoZonaSecundario) : color.gray, text_size=size.small, bgcolor=colorFondoNeutral)

        table.cell(tablero, 3, 1, textoEstructura, text_color=colorTextoEstructura, text_size=size.normal, bgcolor=fondoEstructura, text_halign=text.align_center)

        table.cell(tablero, 0, 3, "ESTADO RANGO:", text_color=color.black, text_size=size.small, bgcolor=colorFondoNeutral, text_halign=text.align_left)

        table.cell(tablero, 1, 3, textoEstadoRango, text_color=colorTextoEstadoRango, text_size=size.normal, bgcolor=fondoEstadoRango, text_halign=text.align_center)
    else
        table.clear(tablero, 0, 0, 3, 3)

alertcondition(rangoAlineadoArriba or zonaAlineadaArriba, "DASH BUY alineado", "Principal y secundario estan alineados para compras.")

alertcondition(rangoAlineadoAbajo or zonaAlineadaAbajo, "DASH SELL alineado", "Principal y secundario estan alineados para ventas.")

alertcondition(direccionesOpuestas, "DASH divergencia", "Principal y secundario estan en direcciones opuestas.")

//=============================================================================
// 16. ELIMINAR NIVELES ANTERIORES CUANDO SE DIBUJE UNA ZONA NUEVA
//=============================================================================
var int sesionConNiveles = 0
var int inicioZonaConNiveles = na

bool zonaAsiaDibujada = not na(inicioAsia) and maximoAsia - minimoAsia > syminfo.mintick and (terminaAsia or (dentroAsia and barstate.islast))
bool zonaLondonDibujada = not na(inicioLondon) and maximoLondon - minimoLondon > syminfo.mintick and (terminaLondon or (dentroLondon and barstate.islast))
bool zonaNYDibujada = not na(inicioNY) and maximoNY - minimoNY > syminfo.mintick and (terminaNY or (dentroNY and barstate.islast))

if zonaAsiaDibujada and (na(inicioZonaConNiveles) or inicioAsia > inicioZonaConNiveles)
    sesionConNiveles := 1
    inicioZonaConNiveles := inicioAsia

if zonaLondonDibujada and (na(inicioZonaConNiveles) or inicioLondon > inicioZonaConNiveles)
    sesionConNiveles := 2
    inicioZonaConNiveles := inicioLondon

if zonaNYDibujada and (na(inicioZonaConNiveles) or inicioNY > inicioZonaConNiveles)
    sesionConNiveles := 3
    inicioZonaConNiveles := inicioNY

if sesionConNiveles > 0
    if sesionConNiveles != 1
        f_limpiarLineas(lineasAsia)

    if sesionConNiveles != 2
        f_limpiarLineas(lineasLondon)

    if sesionConNiveles != 3
        f_limpiarLineas(lineasNY)
